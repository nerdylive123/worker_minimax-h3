{
  "tests": [
    {
      "name": "comfyui_health",
      "input": { "route": "/", "method": "GET" },
      "timeout": 120000
    },
    {
      "name": "text_to_video_tiny",
      "input": {
        "action": "t2v",
        "prompt": "a cat sitting on a windowsill, soft daylight",
        "width": 608,
        "height": 352,
        "duration": 4,
        "turbo": true,
        "turbo_steps": 4,
        "return_base64": false
      },
      "timeout": 900000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA H100 80GB HBM3",
    "gpuCount": 1,
    "env": [
      { "key": "MODEL_VARIANT", "value": "fl2va" },
      { "key": "PRECISION", "value": "int8_convrot" }
    ]
  }
}
